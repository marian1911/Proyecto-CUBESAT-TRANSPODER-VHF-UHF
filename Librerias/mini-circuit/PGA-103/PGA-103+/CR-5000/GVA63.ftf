(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r150_71.1
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 71100)
            (height 150000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r200_91.4
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 91400)
            (height 200000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r333.4_190.5
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 190500)
            (height 333400)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r150_71.1
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r150_71.1))
          (noconnect (pad r150_71.1))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r150_71.1))
          (noconnect (pad r150_71.1))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r150_71.1))
          (noconnect (pad r150_71.1))
        )
      )
      (padstack r200_91.4
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r200_91.4))
          (noconnect (pad r200_91.4))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r200_91.4))
          (noconnect (pad r200_91.4))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r200_91.4))
          (noconnect (pad r200_91.4))
        )
      )
      (padstack r333.4_190.5
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r333.4_190.5))
          (noconnect (pad r333.4_190.5))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r333.4_190.5))
          (noconnect (pad r333.4_190.5))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r333.4_190.5))
          (noconnect (pad r333.4_190.5))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "GVA63"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -224800 242000
                        (width 20000)
                      )
                      (pt 224800 242000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 224800 242000
                        (width 20000)
                      )
                      (pt 224800 -2000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 224800 -2000
                        (width 20000)
                      )
                      (pt -224800 -2000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -224800 -2000
                        (width 20000)
                      )
                      (pt -224800 242000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 324800 431400)
                    (pt 324800 -342000)
                    (pt -324800 -342000)
                    (pt -324800 431400)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -150000 242000
                        (width 10000)
                      )
                      (pt -224800 242000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -224800 242000
                        (width 10000)
                      )
                      (pt -224800 -2000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -224800 -2000
                        (width 10000)
                      )
                      (pt -150000 -2000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 150000 -2000
                        (width 10000)
                      )
                      (pt 224800 -2000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 224800 -2000
                        (width 10000)
                      )
                      (pt 224800 242000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 224800 242000
                        (width 10000)
                      )
                      (pt 150000 242000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -150000 -222000
                        (width 20000)
                      )
                      (pt -150000 -222000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 10000)
                        (begin
                          (pt -150000 -222000
                            (width 20000)
                          )
                        )
                        (center 0 -1073741824)
                        (end
                          (pt -150000 -242000
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 10000)
                        (begin
                          (pt -150000 -242000
                            (width 20000)
                          )
                        )
                        (center 0 1073741824)
                        (end
                          (pt -150000 -222000
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -150000 -127000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -150000 -127000)
                  (angle 0)
                  (padstackGroup default (padstack r150_71.1))
                )
              )
            )
          )
          (pin 2
            (pt 0 -102000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 -102000)
                  (angle 0)
                  (padstackGroup default (padstack r200_91.4))
                )
              )
            )
          )
          (pin 3
            (pt 150000 -127000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 150000 -127000)
                  (angle 0)
                  (padstackGroup default (padstack r150_71.1))
                )
              )
            )
          )
          (pin 4
            (pt 0 164700)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 164700)
                  (angle 0)
                  (padstackGroup default (padstack r333.4_190.5))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape PGA-103+.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

