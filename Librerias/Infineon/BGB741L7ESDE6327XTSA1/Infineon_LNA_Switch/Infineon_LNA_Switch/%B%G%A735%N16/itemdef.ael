      parmList = pcb_set_string(parmList, "IIP3", "\"-3 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -16-1\"");
    } 
    else if(type == "BGA735N16 (LB) Vcc=2.8V Lowgain")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA735N16_LB_2p8V_LowGain.s2p\"");
