      parmList = pcb_set_string(parmList, "Package", "\"TSNP -16-1\"");
    } 
    else if(type == "BGA735N16 (MB) Vcc=2.8V HighGain")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA735N16_MB_2p8V_HighGain.s2p\"");
