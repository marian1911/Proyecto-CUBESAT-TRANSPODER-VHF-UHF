/*-------modified value parameter callback function--------*/
defun BGA735N16_parm_modifiedValue_cb ( cbP, parmName, itemInfoP ) 
{ 
  decl parmList = NULL; 
  decl type; 
  type = pcb_get_form_value(itemInfoP, "Type");
 
 if(parmName == "Type")
  {
    if(type == "BGA735N16 (HB) Vcc=2.8V HighGain")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA735N16_HB_2p8V_HighGain.s2p\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "1800 - 2700 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "2.6 -3.0 V");
      parmList = pcb_set_string(parmList, "Icc", "3.4 mA");
      parmList = pcb_set_string(parmList, "Gain", "16 dB");
      parmList = pcb_set_string(parmList, "NF", "1.1 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-7 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"-3 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -16-1\"");
    } 
    else if(type == "BGA735N16 (HB) Vcc=2.8V LowGain")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA735N16_HB_2p8V_LowGain.s2p\"");
