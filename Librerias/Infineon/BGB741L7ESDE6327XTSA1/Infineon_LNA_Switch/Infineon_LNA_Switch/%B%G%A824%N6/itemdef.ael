BGA824N6_net = strcat(Infineon_LNA_Switch_CIRCUIT_MODEL_DIR, "BGA824N6_cktName.net");
BGA824N6_SPCompNetlistFmt= strcat("#include \"",BGA824N6_net, "\" \n%d:%t%# %44?0%:%31?%C%:_net%c%;%;%e %r%b%8?%29?%:%30?%p%:%k%?[%1i]%;=%p %;%;%e%e");

