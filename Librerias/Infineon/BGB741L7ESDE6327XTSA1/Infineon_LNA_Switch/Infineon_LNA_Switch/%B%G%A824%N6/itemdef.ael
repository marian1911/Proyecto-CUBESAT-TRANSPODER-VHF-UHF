/*---------global variables------------------*/

decl type_default = "BGA824N6 Vcc=2.8V"; 

/*---------forms and formset------------------*/

create_constant_form("BGA824N6 Vcc=2.8V","BGA824N6 Vcc=2.8V", 0, " ", "BGA824N6 Vcc=2.8V");
create_constant_form("BGA824N6 Vcc=1.8V","BGA824N6 Vcc=1.8V", 0, " ", "BGA824N6 Vcc=1.8V");

create_form_set("formset_type", "BGA824N6 Vcc=2.8V", "BGA824N6 Vcc=1.8V");



/*-------modified value parameter callback function--------*/
defun BGA824N6_parm_modifiedValue_cb ( cbP, parmName, itemInfoP ) 
{ 
  decl parmList = NULL; 
  decl type; 
  type = pcb_get_form_value(itemInfoP, "Type");
 
 if(parmName == "Type")
  {
    if(type == "BGA824N6 Vcc=2.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA824N6_2p8V.s2p\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "1150 - 1615 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 - 3.3 V");
      parmList = pcb_set_string(parmList, "Icc", "3.8 mA");
      parmList = pcb_set_string(parmList, "Gain", "17.0 dB");
      parmList = pcb_set_string(parmList, "NF", "0.55 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-9 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"+2 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
    else if(type == "BGA824N6 Vcc=1.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA824N6_1p8V.s2p\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "1150 - 1615 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 - 3.3 V");
      parmList = pcb_set_string(parmList, "Icc", "3.8 mA");
      parmList = pcb_set_string(parmList, "Gain", "17.0 dB");
      parmList = pcb_set_string(parmList, "NF", "0.55 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-9 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"+2 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
  }
  return(parmList);
}

decl BGA824N6_SPCompNetlistFmt = ""; 
