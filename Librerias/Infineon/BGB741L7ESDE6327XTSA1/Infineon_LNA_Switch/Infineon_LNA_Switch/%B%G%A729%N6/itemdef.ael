decl type_default = "BGA729N6 Vcc=1.8 V HighGain"; 

/*---------forms and formset------------------*/

create_constant_form("BGA729N6 Vcc=1.8 V HighGain","BGA729N6 Vcc=1.8 V HighGain", 0, " ", "BGA729N6 Vcc=1.8 V HighGain");
create_constant_form("BGA729N6 Vcc=2.8 V HighGain","BGA729N6 Vcc=2.8 V HighGain", 0, " ", "BGA729N6 Vcc=2.8 V HighGain");
create_constant_form("BGA729N6 Vcc=1.8 V Bypass","BGA729N6 Vcc=1.8 V Bypass", 0, " ", "BGA729N6 Vcc=1.8 V Bypass");
create_constant_form("BGA729N6 Vcc=2.8 V Bypass","BGA729N6 Vcc=2.8 V Bypass", 0, " ", "BGA729N6 Vcc=2.8 V Bypass");

create_form_set("formset_type", "BGA729N6 Vcc=1.8 V HighGain", "BGA729N6 Vcc=2.8 V HighGain", "BGA729N6 Vcc=1.8 V Bypass", "BGA729N6 Vcc=2.8 V Bypass"
	);



/*-------modified value parameter callback function--------*/
defun BGA729N6_parm_modifiedValue_cb ( cbP, parmName, itemInfoP ) 
{ 
  decl parmList = NULL; 
  decl type; 
  type = pcb_get_form_value(itemInfoP, "Type");
 
 if(parmName == "Type")
  {
    if(type == "BGA729N6 Vcc=1.8 V HighGain")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA729_DEVICELVL_1V8_HG.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "70 -1000 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.3 V");
      parmList = pcb_set_string(parmList, "Icc", "6.3 mA");
      parmList = pcb_set_string(parmList, "Gain", "16.3 dB");
      parmList = pcb_set_string(parmList, "NF", "1.05 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-16 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"-4 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP-6-2\"");
    } 
    else if(type == "BGA729N6 Vcc=2.8 V HighGain")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA729_DEVICELVL_2V8_HG.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "70 -1000 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.3 V");
      parmList = pcb_set_string(parmList, "Icc", "6.3 mA");
      parmList = pcb_set_string(parmList, "Gain", "16.5 dB");
      parmList = pcb_set_string(parmList, "NF", "1.05 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-16 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"-4 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP-6-2\"");
    } 
    else if(type == "BGA729N6 Vcc=1.8 V Bypass")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA729_DEVICELVL_1V8_Bypass.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "70 -1000 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.3 V");
      parmList = pcb_set_string(parmList, "Icc", "6.3 mA");
      parmList = pcb_set_string(parmList, "Gain", "-4.5 dB");
      parmList = pcb_set_string(parmList, "NF", "5.0 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"3 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"16 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP-6-2\"");
    } 
    else if(type == "BGA729N6 Vcc=2.8 V Bypass")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA729_DEVICELVL_2V8_Bypass.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "70 -1000 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.3 V");
      parmList = pcb_set_string(parmList, "Icc", "6.3 mA");
      parmList = pcb_set_string(parmList, "Gain", "-4.2 dB");
      parmList = pcb_set_string(parmList, "NF", "5.0 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"6 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"21 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP-6-2\"");
    } 
  }
  return(parmList);
}

decl BGA729N6_SPCompNetlistFmt = ""; 
decl BGA729N6_net=" "; 
BGA729N6_net = strcat(Infineon_LNA_Switch_CIRCUIT_MODEL_DIR, "BGA729N6_cktName.net");
BGA729N6_SPCompNetlistFmt= strcat("#include \"",BGA729N6_net, "\" \n%d:%t%# %44?0%:%31?%C%:_net%c%;%;%e %r%b%8?%29?%:%30?%p%:%k%?[%1i]%;=%p %;%;%e%e");

