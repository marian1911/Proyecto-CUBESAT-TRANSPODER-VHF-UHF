/*-------modified value parameter callback function--------*/
defun BGA7H1BN6_parm_modifiedValue_cb ( cbP, parmName, itemInfoP ) 
{ 
  decl parmList = NULL; 
  decl type; 
  type = pcb_get_form_value(itemInfoP, "Type");
 
 if(parmName == "Type")
  {
    if(type == "BGA7H1BN6 HighGain Vcc=2.8V_f=2500 MHz")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA7H1BN6_2V8_HG_2500MHz.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "1805- 2690 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.6 V");
      parmList = pcb_set_string(parmList, "Icc", "4.3 mA");
      parmList = pcb_set_string(parmList, "Gain", "12.3 dB");
      parmList = pcb_set_string(parmList, "NF", "0.85 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-3 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"+2 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
    else if(type == "BGA7H1BN6 HighGain Vcc=2.8V_f=2000 MHz")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA7H1BN6_2V8_HG_2500MHz.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "1805- 2690 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.6 V");
      parmList = pcb_set_string(parmList, "Icc", "4.3 mA");
      parmList = pcb_set_string(parmList, "Gain", "12.3 dB");
      parmList = pcb_set_string(parmList, "NF", "0.85 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-3 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"+2 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
    else if(type == "BGA7H1BN6 Bypass Vcc=2.8V_f=2500 MHz_1")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA7H1BN6_2V8_BP_2500MHz.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "1805- 2690 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.6 V");
      parmList = pcb_set_string(parmList, "Icc", "4.3 mA");
      parmList = pcb_set_string(parmList, "Gain", "12.3 dB");
      parmList = pcb_set_string(parmList, "NF", "0.85 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-3 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"+2 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
    else if(type == "BGA7H1BN6 Bypass Vcc=2.8V_f=2000 MHz_2")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA7H1BN6_2V8_BP_2000MHz.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "1805- 2690 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.6 V");
      parmList = pcb_set_string(parmList, "Icc", "4.3 mA");
      parmList = pcb_set_string(parmList, "Gain", "12.3 dB");
      parmList = pcb_set_string(parmList, "NF", "0.85 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-3 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"+2 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
  }
  return(parmList);
}

