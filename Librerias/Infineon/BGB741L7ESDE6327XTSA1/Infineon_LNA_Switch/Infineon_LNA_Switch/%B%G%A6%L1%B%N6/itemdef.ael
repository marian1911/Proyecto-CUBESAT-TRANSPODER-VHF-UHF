/*-------modified value parameter callback function--------*/
defun BGA6L1BN6_parm_modifiedValue_cb ( cbP, parmName, itemInfoP ) 
{ 
  decl parmList = NULL; 
  decl type; 
  type = pcb_get_form_value(itemInfoP, "Type");
 
 if(parmName == "Type")
  {
    if(type == "BGA6L1BN6 HighGain Vcc= 2.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA6L1BN6_2P8_HG.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "716 - 960 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.3 V");
      parmList = pcb_set_string(parmList, "Icc", "5.8 mA");
      parmList = pcb_set_string(parmList, "Gain", "16.1 dB");
      parmList = pcb_set_string(parmList, "NF", "0.6 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"- 5 dBm\"");
      parmList = pcb_set_string(parmList, "IIp3", "\"+ 2 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
    else if(type == "BGA6L1BN6 HighGain Vcc= 1.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA6L1BN6_1P8_HG.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "716 - 960 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.3 V");
      parmList = pcb_set_string(parmList, "Icc", "5.1 mA");
      parmList = pcb_set_string(parmList, "Gain", "15.7 dB");
      parmList = pcb_set_string(parmList, "NF", "0.6 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"- 6.8 dBm\"");
      parmList = pcb_set_string(parmList, "IIp3", "\"+ 1 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
    else if(type == "BGA6L1BN6 Bypass Vcc= 2.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA6L1BN6_2P8_Bypass.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "716 - 960 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.3 V");
      parmList = pcb_set_string(parmList, "Icc", "0.4 mA");
      parmList = pcb_set_string(parmList, "Gain", "-1.8 dB");
      parmList = pcb_set_string(parmList, "NF", "1.8 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"+8 dBm\"");
      parmList = pcb_set_string(parmList, "IIp3", "\"+ 23 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
    else if(type == "BGA6L1BN6 Bapass Vcc= 1.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA6L1BN6_1P8_Bypass.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "716 - 960 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.5 -3.3 V");
      parmList = pcb_set_string(parmList, "Icc", "0.3 mA");
      parmList = pcb_set_string(parmList, "Gain", "-1.7 dB");
      parmList = pcb_set_string(parmList, "NF", "1.7 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"+7 dBm\"");
      parmList = pcb_set_string(parmList, "IIp3", "\"+ 2 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
  }
  return(parmList);
}

