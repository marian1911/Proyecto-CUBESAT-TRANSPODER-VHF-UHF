/*-------modified value parameter callback function--------*/
defun BGM12LBA9_parm_modifiedValue_cb ( cbP, parmName, itemInfoP ) 
{ 
  decl parmList = NULL; 
  decl type; 
  type = pcb_get_form_value(itemInfoP, "Type");
 
 if(parmName == "Type")
  {
    if(type == "BGM12LBA9 RX1 HighGain Vcc=2.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGM12LBA9_RX1_2P8V_HG.S2P\"");
