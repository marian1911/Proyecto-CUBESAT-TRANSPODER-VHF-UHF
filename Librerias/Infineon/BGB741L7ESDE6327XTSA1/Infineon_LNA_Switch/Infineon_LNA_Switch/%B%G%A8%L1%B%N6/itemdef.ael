/*-------modified value parameter callback function--------*/
defun BGA8L1BN6_parm_modifiedValue_cb ( cbP, parmName, itemInfoP ) 
{ 
  decl parmList = NULL; 
  decl type; 
  type = pcb_get_form_value(itemInfoP, "Type");
 
 if(parmName == "Type")
  {
    if(type == "BGA8L1BN6 HighGain Vcc=2.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA8L1BN6_2P8V_HG.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "617 - 960 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.6 - 3.1 V");
      parmList = pcb_set_string(parmList, "Icc", "5.7 mA");
      parmList = pcb_set_string(parmList, "Gain", "13.2 dB");
      parmList = pcb_set_string(parmList, "NF", "0.75 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-3 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"+1 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
    else if(type == "BGA8L1BN6 HighGain Vcc=1.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA8L1BN6_1P8V_HG.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "617 - 960 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.6 - 3.1 V");
      parmList = pcb_set_string(parmList, "Icc", "5.3 mA");
      parmList = pcb_set_string(parmList, "Gain", "13.0 dB");
      parmList = pcb_set_string(parmList, "NF", "0.75 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"-3 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"+1 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
    else if(type == "BGA8L1BN6 Bypass Vcc=2.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA8L1BN6_2P8V_BYP.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "617 - 960 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.6 - 3.1 V");
      parmList = pcb_set_string(parmList, "Icc", "175 uA");
      parmList = pcb_set_string(parmList, "Gain", "-2.6 dB");
      parmList = pcb_set_string(parmList, "NF", "2.6 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"+8 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"+1 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
    else if(type == "BGA8L1BN6 Bypass Vcc=1.8V")
    {
      parmList = pcb_set_string(parmList, "File", "\"BGA8L1BN6_1P8V_BYP.S2P\"");
      parmList = pcb_set_string(parmList, "Temp", "25");
      parmList = pcb_set_string(parmList, "Frequency", "617 - 960 MHz");
      parmList = pcb_set_string(parmList, "Vcc", "1.6 - 3.1 V");
      parmList = pcb_set_string(parmList, "Icc", "102 uA");
      parmList = pcb_set_string(parmList, "Gain", "-2.7 dB");
      parmList = pcb_set_string(parmList, "NF", "2.6 dB");
      parmList = pcb_set_string(parmList, "IP1dB", "\"+8 dBm\"");
      parmList = pcb_set_string(parmList, "IIP3", "\"+1 dBm\"");
      parmList = pcb_set_string(parmList, "Package", "\"TSNP -6-2\"");
    } 
  }
  return(parmList);
}

